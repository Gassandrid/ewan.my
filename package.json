{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "docs": "node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "check": "tsc --noEmit && npm run format:check",
    "format:check": "prettier '.github/**/*.{yml,yaml}' 'quartz/**/*.{ts,tsx,scss}' 'plugins/**/*.{js,json}' 'scripts/**/*.mjs' '*.json' '*.yaml' --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "plugins:install": "node ./quartz/bootstrap-cli.mjs plugin install --from-config",
    "build": "node ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "probe": "node ./scripts/probe-build.mjs",
    "probe:browser": "node ./scripts/probe-browser.mjs",
    "probe:eigenfish": "node ./scripts/probe-marimo-eigenfish.mjs",
    "probe:showcase": "node ./scripts/probe-marimo-showcase.mjs",
    "probe:responsive": "node ./scripts/probe-responsive-layout.mjs",
    "validate": "npm run plugins:install && npm run check && npm test && npm run build && npm run probe"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@myriaddreamin/rehype-typst": "^0.7.0",
    "@napi-rs/simple-git": "1.1.0",
    "ansi-truncate": "^1.4.0",
    "async-mutex": "^0.5.0",
    "chokidar": "^5.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "github-slugger": "^2.0.0",
    "globby": "^16.2.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "isomorphic-git": "^1.41.9",
    "lightningcss": "^1.33.0",
    "micromorph": "^0.4.5",
    "minimatch": "^10.2.6",
    "node-tikzjax": "^1.0.5",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "pretty-bytes": "^7.1.2",
    "pretty-time": "^1.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rfdc": "^1.4.1",
    "serve-handler": "^6.1.6",
    "sharp": "^0.35.4",
    "source-map-support": "^0.5.21",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "workerpool": "^10.0.3",
    "ws": "^8.21.3",
    "yaml": "^2.8.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/pretty-time": "^1.1.5",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
