{
  "name": "@ewan/quartz-telemetry",
  "version": "1.0.0",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components.js"
  },
  "peerDependencies": {
    "preact": "^10.28.2"
  },
  "quartz": {
    "name": "ewan-telemetry",
    "displayName": "Ewan Interaction Telemetry",
    "description": "Load the site interaction telemetry after the page is ready.",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "category": "component",
    "defaultOrder": 50,
    "components": {
      "Telemetry": {
        "displayName": "Interaction Telemetry",
        "defaultPosition": "afterBody",
        "defaultPriority": 90
      }
    }
  }
}
