#!/usr/bin/env python3
"""Resolve and validate existing VAULT tags without loading the full tag atlas.

The tag atlas remains the canonical policy document.  This command is its
compact, live lookup surface: it reads the atlas and scans current Markdown
metadata so agents can choose from existing tags before they write a note.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path


VAULT = Path(__file__).resolve().parent.parent
ATLAS = VAULT / "Private/Agent Map/agent_tag_index.md"
TAG_RE = re.compile(r"(?<![\w/])#([A-Za-z0-9][A-Za-z0-9_/-]*)")
INLINE_TAGS_RE = re.compile(r"(?m)^tags:\s*\[([^\]]*)\]\s*$")
LIST_TAGS_RE = re.compile(r"(?ms)^tags:\s*\n((?:[ \t]+-\s*[^\n]+\n?)*)")
TAG_VALUE_RE = re.compile(r"^[\s'\"]*#?([^\s,'\"\]]+)")
DEPRECATION_RE = re.compile(r"`#?([^`]+)`\s*→\s*`#?([^`]+)`")
STOP = {"a", "an", "and", "for", "from", "in", "note", "of", "on", "the", "to", "with"}


def clean(value: str) -> str:
    # YAML comments are not part of a tag value. Preserve a leading #, which
    # is accepted input syntax, but discard an inline comment after whitespace.
    value = value.strip()
    if " #" in value:
        value = value.split(" #", 1)[0]
    return value.strip().strip("'\"").lstrip("#").rstrip(".,;:")


def live_tags() -> set[str]:
    tags: set[str] = set()
    for path in VAULT.rglob("*.md"):
        if any(part.startswith(".") for part in path.relative_to(VAULT).parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            continue
        tags.update(TAG_RE.findall(text))
        for match in INLINE_TAGS_RE.finditer(text):
            tags.update(clean(value) for value in match.group(1).split(",") if clean(value))
        for match in LIST_TAGS_RE.finditer(text):
            for line in match.group(1).splitlines():
                value = line.split("-", 1)[-1]
                candidate = clean(value)
                if candidate:
                    tags.add(candidate)
    return tags


def atlas_tags() -> set[str]:
    return set(TAG_RE.findall(ATLAS.read_text(encoding="utf-8")))


def deprecated_tags() -> dict[str, str]:
    """Read canonical replacements from the atlas instead of hard-coding them."""
    return {
        clean(old): clean(new.split(" or ", 1)[0])
        for old, new in DEPRECATION_RE.findall(ATLAS.read_text(encoding="utf-8"))
    }


def legacy_tags() -> set[str]:
    """Read atlas-listed legacy/imported tags that must not be reused."""
    return {
        tag
        for line in ATLAS.read_text(encoding="utf-8").splitlines()
        if "legacy or imported noise" in line
        for tag in TAG_RE.findall(line)
    }


def query_tokens(query: str) -> list[str]:
    return [token.lower() for token in re.findall(r"[A-Za-z0-9]+", query) if token.lower() not in STOP]


def score(tag: str, terms: list[str]) -> int:
    normalized = tag.lower().replace("-", " ").replace("_", " ").replace("/", " ")
    parts = re.findall(r"[a-z0-9]+", normalized)
    total = 0
    for term in terms:
        if term == tag.lower():
            total += 100
        elif term in parts:
            total += 30
        elif any(part.startswith(term) for part in parts):
            total += 16
        elif term in normalized:
            total += 7
    return total + tag.count("/")


def suggest(args: argparse.Namespace) -> int:
    atlas = atlas_tags()
    deprecated = deprecated_tags()
    tags = (live_tags() | atlas) - set(deprecated) - legacy_tags()
    terms = query_tokens(args.query)
    ranked = sorted(
        ((score(tag, terms), tag) for tag in tags), key=lambda row: (-row[0], row[1].lower())
    )
    ranked = [(value, tag) for value, tag in ranked if value > 0][: args.limit]
    print(f"Tag atlas: {ATLAS.relative_to(VAULT)} (live tag scan; {len(tags)} known tags)")
    if not ranked:
        print("No existing match. Leave tags sparse; do not mint a new tag.")
        return 0
    print("Existing candidates (choose only these or validate another existing tag):")
    for value, tag in ranked:
        source = "atlas" if tag in atlas else "live vault"
        print(f"  #{tag}\t[{source}; score {value}]")
    return 0


def validate(args: argparse.Namespace) -> int:
    atlas = atlas_tags()
    deprecated = deprecated_tags()
    legacy = legacy_tags()
    tags = live_tags() | atlas
    unknown = []
    for raw in args.tags:
        tag = clean(raw)
        if tag in deprecated:
            unknown.append(tag)
            print(f"DEPRECATED\t#{tag}\t[use #{deprecated[tag]} instead]")
        elif tag in legacy:
            unknown.append(tag)
            print(f"LEGACY\t#{tag}\t[do not reuse it]")
        elif tag in tags:
            source = "atlas" if tag in atlas else "live vault"
            print(f"OK\t#{tag}\t[{source}]")
        else:
            unknown.append(tag)
            print(f"UNKNOWN\t#{tag}\t[do not write it]")
    return 1 if unknown else 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Resolve existing VAULT tags from the canonical atlas and live vault.")
    sub = parser.add_subparsers(dest="command", required=True)
    suggest_parser = sub.add_parser("suggest", help="show existing tag candidates for a note topic")
    suggest_parser.add_argument("query", help="plain-language note topic or prospective tag")
    suggest_parser.add_argument("--limit", type=int, default=12)
    suggest_parser.set_defaults(func=suggest)
    validate_parser = sub.add_parser("validate", help="reject tags that do not already exist")
    validate_parser.add_argument("tags", nargs="+", help="tag values with or without #")
    validate_parser.set_defaults(func=validate)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
